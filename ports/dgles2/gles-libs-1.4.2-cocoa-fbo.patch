diff --git a/dgles2/src/EGL/cocoa_fbo.c b/dgles2/src/EGL/cocoa_fbo.c
new file mode 100644
index 0000000..95390d5
--- /dev/null
+++ b/dgles2/src/EGL/cocoa_fbo.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: MIT
+ * Experimental Apple Silicon offscreen backend for Nokia DGLES2.
+ * No window, PBuffer, software renderer, or guest ABI changes are involved.
+ */
+#include <OpenGL/gl.h>
+#include <OpenGL/glext.h>
+#include "context.h"
+#include "degl.h"
+
+static void preserve_gl_error(void)
+{
+    /* EGL's internal rendering must not swallow a client's pending GL error. */
+    GLenum error = glGetError();
+    if(error != GL_NO_ERROR && deglGetTLS()->glError == GL_NO_ERROR)
+        deglGetTLS()->glError = error;
+}
+
+static void delete_objects(DEGLSurface *s)
+{
+    if(s->cocoa.fbo) glDeleteFramebuffersEXT(1, &s->cocoa.fbo);
+    if(s->cocoa.color_buffer)
+        glDeleteRenderbuffersEXT(1, &s->cocoa.color_buffer);
+    if(s->cocoa.depth_stencil_buffer)
+        glDeleteRenderbuffersEXT(1, &s->cocoa.depth_stencil_buffer);
+    s->cocoa.fbo = s->cocoa.color_buffer = s->cocoa.depth_stencil_buffer = 0;
+}
+
+EGLBoolean deglCocoaBindFBO(DEGLSurface *s, GLuint previous_default)
+{
+    CGLContextObj owner = CGLGetCurrentContext();
+    if(!owner || s->type != DEGLSurface_offscreen || !s->ddraw ||
+       s->ddraw->width < 1 || s->ddraw->width > 4096 ||
+       s->ddraw->height < 1 || s->ddraw->height > 4096 || s->ddraw->bpp != 4)
+    {
+        deglSetError(EGL_BAD_MATCH);
+        return EGL_FALSE;
+    }
+    /* FBO names are context-local. Cross-context surface reuse needs its own
+     * container/attachment ownership design; reject it, never show stale data. */
+    if(s->cocoa.fbo_owner && s->cocoa.fbo_owner != owner)
+    {
+        deglSetError(EGL_BAD_ACCESS);
+        return EGL_FALSE;
+    }
+    s->width = s->ddraw->width;
+    s->height = s->ddraw->height;
+    s->depth = s->ddraw->depth;
+    s->bpp = s->ddraw->bpp;
+    GLint previous_fbo = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &previous_fbo);
+    int default_bound = !previous_fbo || previous_fbo == (GLint)previous_default;
+    if(s->cocoa.fbo && s->cocoa.fbo_width == s->width &&
+       s->cocoa.fbo_height == s->height)
+    {
+        if(default_bound) glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, s->cocoa.fbo);
+        return EGL_TRUE;
+    }
+    GLint previous_rb = 0;
+    preserve_gl_error();
+    glGetIntegerv(GL_RENDERBUFFER_BINDING_EXT, &previous_rb);
+    delete_objects(s);
+    if(!s->cocoa.fbo_owner) s->cocoa.fbo_owner = CGLRetainContext(owner);
+    glGenFramebuffersEXT(1, &s->cocoa.fbo);
+    glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, s->cocoa.fbo);
+    glGenRenderbuffersEXT(1, &s->cocoa.color_buffer);
+    glBindRenderbufferEXT(GL_RENDERBUFFER_EXT, s->cocoa.color_buffer);
+    glRenderbufferStorageEXT(GL_RENDERBUFFER_EXT, GL_RGBA8, s->width, s->height);
+    glFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT,
+                                GL_RENDERBUFFER_EXT, s->cocoa.color_buffer);
+    if(s->config->depth_bits || s->config->stencil_bits)
+    {
+        glGenRenderbuffersEXT(1, &s->cocoa.depth_stencil_buffer);
+        glBindRenderbufferEXT(GL_RENDERBUFFER_EXT, s->cocoa.depth_stencil_buffer);
+        glRenderbufferStorageEXT(GL_RENDERBUFFER_EXT, GL_DEPTH24_STENCIL8_EXT,
+                                 s->width, s->height);
+        if(s->config->depth_bits)
+            glFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_DEPTH_ATTACHMENT_EXT,
+                GL_RENDERBUFFER_EXT, s->cocoa.depth_stencil_buffer);
+        if(s->config->stencil_bits)
+            glFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_STENCIL_ATTACHMENT_EXT,
+                GL_RENDERBUFFER_EXT, s->cocoa.depth_stencil_buffer);
+    }
+    GLenum status = glCheckFramebufferStatusEXT(GL_FRAMEBUFFER_EXT);
+    glBindRenderbufferEXT(GL_RENDERBUFFER_EXT, previous_rb);
+    if(status != GL_FRAMEBUFFER_COMPLETE_EXT || glGetError() != GL_NO_ERROR)
+    {
+        fprintf(stderr, "DGLES2 offscreen FBO incomplete: 0x%x\n", status);
+        delete_objects(s);
+        deglSetError(EGL_BAD_ALLOC);
+        return EGL_FALSE;
+    }
+    s->cocoa.fbo_width = s->width;
+    s->cocoa.fbo_height = s->height;
+    if(!default_bound) glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, previous_fbo);
+    return EGL_TRUE;
+}
+
+GLuint deglCocoaDefaultFBO(void)
+{
+    DEGLContext *context = deglGetTLS()->current_context;
+    if(!degl_cocoa_fbo || degl_backend != DEGLBackend_cocoa ||
+       degl_frontend != DEGLFrontend_offscreen || !context || !context->draw)
+        return 0;
+    return context->draw->cocoa.fbo;
+}
+
+EGLBoolean deglCocoaReadFBO(DEGLSurface *s)
+{
+    if(!s->cocoa.fbo || s->cocoa.fbo_owner != CGLGetCurrentContext() ||
+       !s->ddraw->pixels)
+    {
+        deglSetError(EGL_BAD_SURFACE);
+        return EGL_FALSE;
+    }
+    size_t row_size = (size_t)s->width * 4;
+    unsigned char *buffer = malloc(row_size * s->height);
+    if(!buffer)
+    {
+        deglSetError(EGL_BAD_ALLOC);
+        return EGL_FALSE;
+    }
+    GLint saved_fbo = 0, saved_pbo = 0, saved_read = 0;
+    preserve_gl_error();
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING_EXT, &saved_fbo);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &saved_pbo);
+    glGetIntegerv(GL_READ_BUFFER, &saved_read);
+    glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, s->cocoa.fbo);
+    glReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
+    glPushClientAttrib(GL_CLIENT_PIXEL_STORE_BIT);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glPixelStorei(GL_PACK_SWAP_BYTES, GL_FALSE);
+    glReadPixels(0, 0, s->width, s->height, GL_BGRA, GL_UNSIGNED_BYTE, buffer);
+    GLenum error = glGetError();
+    glPopClientAttrib();
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, saved_pbo);
+    glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, saved_fbo);
+    glReadBuffer(saved_read);
+    if(error == GL_NO_ERROR)
+    {
+        for(unsigned y = 0; y < s->height; ++y)
+            memcpy((unsigned char *)s->ddraw->pixels + y * row_size,
+                   buffer + (s->height - 1 - y) * row_size, row_size);
+    }
+    free(buffer);
+    if(error != GL_NO_ERROR)
+    {
+        fprintf(stderr, "DGLES2 offscreen FBO readback: 0x%x\n", error);
+        deglSetError(EGL_BAD_ACCESS);
+        return EGL_FALSE;
+    }
+    if(s->ddraw->swap) s->ddraw->swap(s->ddraw->userdata);
+    return EGL_TRUE;
+}
+
+void deglCocoaDestroyFBO(DEGLSurface *s)
+{
+    CGLContextObj owner = s->cocoa.fbo_owner;
+    if(!owner) return;
+    CGLContextObj saved = CGLGetCurrentContext();
+    if(CGLSetCurrentContext(owner) == kCGLNoError) delete_objects(s);
+    CGLSetCurrentContext(saved);
+    CGLReleaseContext(owner);
+    s->cocoa.fbo_owner = NULL;
+}
