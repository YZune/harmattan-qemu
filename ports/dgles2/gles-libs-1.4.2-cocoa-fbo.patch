+static int deglDefaultFramebufferBound(void)
+{
+#if(CONFIG_COCOA == 1)
+	GLuint internal = deglCocoaDefaultFBO();
+	GLint binding = 0;
+	if(internal)
+	{
+		HGL_TLS.GetIntegerv(GL_FRAMEBUFFER_BINDING, &binding);
+		return binding == (GLint)internal;
+	}
+#endif
+	return 0;
+}
+
