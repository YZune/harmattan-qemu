--- a/hw/arm/n00_gles_port.c
+++ b/hw/arm/n00_gles_port.c
@@ -168,6 +168,18 @@ static float float_arg(N00Client *c, unsigned n)
     return value;
 }
 
+/* AAPCS-VFP allocates float arguments independently of core-register integers.
+ * TexParameterf has two integers followed by one float: r0/r1 + s0 for ABI 2,
+ * versus r0/r1/r2 for ABI 1. Never treat the C argument index as a VFP index.
+ */
+static float mixed_float_arg(N00Client *c, unsigned core_slot, unsigned vfp_slot)
+{
+    uint32_t bits = c->abi == 2 ? c->fp[vfp_slot] : arg(c, core_slot);
+    float value;
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
 static uint32_t make_handle(N00GLES *s, void *object, enum HandleKind kind,
                             N00Client *owner, unsigned version)
 {
