+                                                const uint8_t *src,
+                                                int width,
+                                                int pixelsize)
+{
+#if DEPTH == 24
+    memcpy(dest_, src, width * 3);
+#else
+    PIXEL_TYPE *dest = (PIXEL_TYPE *)dest_;
+    unsigned int r, g, b;
+    const uint8_t *end = src + width * 3;
+    while (src < end) {
+        b = ldub_p(src++);
+        g = ldub_p(src++);
+        r = ldub_p(src++);
+        COPY_PIXEL1(dest, glue(rgb_to_pixel, DEPTH)(r, g, b));
