+static const GraphicHwOps n00_lcd_ops = {
+    .invalidate = n00_lcd_panel_invalidate_display,
+    .gfx_update = n00_lcd_panel_update_display,
+};
+
+static void n00_dss_instance_init(Object *obj)
+{
+    struct n00_dss_s *s = (struct n00_dss_s *)obj;
+    SysBusDevice *dev = SYS_BUS_DEVICE(obj);
+    static const MemoryRegionOps * const ops[] = {
+        &omap_diss_ops, &omap_disc_ops, &omap_rfbi_ops,
+        &omap_venc_ops, &omap_dsi_ops
+    };
+    s->mpu_model = omap3430;
+    s->dispc.rev = 0x30;
+    sysbus_init_irq(dev, &s->irq);
+    sysbus_init_irq(dev, &s->drq);
+    for (int i = 0; i < 4; i++) {
+        sysbus_init_irq(dev, &s->dsi.drq[i]);
+    }
+    for (int i = 0; i < 5; i++) {
+        memory_region_init_io(&s->iomem[i], obj, ops[i], s, "n00.dss", 0x400);
+        sysbus_init_mmio(dev, &s->iomem[i]);
+    }
+    s->dispc.lcdframer = timer_new_ns(QEMU_CLOCK_VIRTUAL, n00_dss_framedone, s);
+    s->dsi.xfer_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, omap_dsi_transfer_stop, s);
+    s->lcd.attached = 1;
+    s->lcd.invalidate = 1;
+    s->lcd.ds = graphic_console_init(DEVICE(obj), 0, &n00_lcd_ops, s);
+}
+
+static void n00_dss_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = n00_dss_reset;
+    dc->desc = "Nokia OMAP3 DSS generic DPI port (no DSI panel/VID overlays)";
+}
+
+static const TypeInfo n00_dss_type = {
+    .name = "n00-omap3-dss",
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(struct n00_dss_s),
+    .instance_init = n00_dss_instance_init,
+    .class_init = n00_dss_class_init,
+};
+static void n00_dss_register_types(void)
+{
+    type_register_static(&n00_dss_type);
+}
+type_init(n00_dss_register_types)
