+#endif
+}
+
+static void glue(n00_dss_draw_line24c_, DEPTH)(void *opaque,
+                                                uint8_t *dest_,
+                                                const uint8_t *src,
+                                                int width,
+                                                int pixelsize)
+{
+    PIXEL_TYPE *dest = (PIXEL_TYPE *)dest_;
+    unsigned int r, g, b;
+    const uint8_t *end = src + (width << 2);
+    while (src < end) {
+        src++;
+        b = ldub_p(src++);
+        g = ldub_p(src++);
+        r = ldub_p(src++);
+        COPY_PIXEL1(dest, glue(rgb_to_pixel, DEPTH)(r, g, b));
+    }
+}
