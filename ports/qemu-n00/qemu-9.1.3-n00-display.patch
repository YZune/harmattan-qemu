index 0000000..d34ab73
--- /dev/null
+++ b/hw/arm/n00_i2c_port.c
@@ -0,0 +1,748 @@
+/*
+ * TI OMAP on-chip I2C controller.  Only "new I2C" mode supported.
+ *
+ * Copyright (C) 2007 Andrzej Zaborowski  <balrog@zabor.org>
