+static void n00_dss_framedone(void *opaque)
+{
+    struct n00_dss_s *s = (struct n00_dss_s *)opaque;
+    if (s->dispc.control & 3) { /* DIGITALENABLE | LCDENABLE */
+        if ((s->dispc.control & (1 << 11))) { /* STALLMODE */
+            s->dispc.control &= ~1; /* LCDENABLE */
+            if ((s->rfbi.control & 1)) { /* ENABLE */
+                s->rfbi.pixels = 0;
+                s->rfbi.busy = 0;
+            }
+            if (s->dispc.lcdframer) {
+                timer_del(s->dispc.lcdframer);
+            }
+        } else {
+            if (s->dispc.lcdframer) {
+                timer_mod(s->dispc.lcdframer,
+                               qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)
+                               + NANOSECONDS_PER_SECOND / 10);
+            }
+        }
+        s->dispc.irqst |= 1 | 2;    /* FRAMEDONE | VSYNC */
+        n00_dss_interrupt_update(s);
+    }
+}
