+/* Validate the actual mapped OneNAND region, including its RAM data buffers.
+ * The kernel can relocate GPMC CS0; a fixed physical-address allowlist is wrong.
+ */
+static bool n00_sdk_flash_dma_address_valid(hwaddr addr)
+{
+    if (!n00_sdk_flash) {
+        return false;
+    }
+    MemoryRegionSection section = memory_region_find(get_system_memory(), addr, 1);
+    bool valid = section.mr && memory_region_owner(section.mr) == OBJECT(n00_sdk_flash);
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
 static int n00_dma_address_valid(struct omap_mpu_state_s *mpu,
                                   hwaddr addr)
 {
     return (addr >= N00_SDRAM_BASE && addr < N00_SDRAM_BASE + N00_SDRAM_SIZE)
         || (addr >= N00_SRAM_BASE && addr < N00_SRAM_BASE + N00_SRAM_SIZE)
-        || (addr >= N00_MMC2_BASE && addr < N00_MMC2_BASE + 0x1000);
+        || (addr >= N00_MMC2_BASE && addr < N00_MMC2_BASE + 0x1000)
+        || n00_sdk_flash_dma_address_valid(addr);
 }
 
