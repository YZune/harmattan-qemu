+/* Independent diagnostic: renew a short activity only for delivered input.
+ * All Foundation objects and lease state belong to the Cocoa main queue. */
+static bool n00_interaction_enabled;
+static bool n00_interaction_closed;
+static id<NSObject> n00_interaction_token;
+static id n00_interaction_observers[3];
+static dispatch_source_t n00_interaction_timer;
+static uint64_t n00_interaction_generation;
+static int64_t n00_interaction_deadline;
+#define N00_INTERACTION_NS (8LL * NANOSECONDS_PER_SECOND)
+
+static void n00_interaction_release(unsigned reason)
+{
+    assert([NSThread isMainThread]);
+    if (!n00_interaction_token) {
+        return;
+    }
+    NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+    [[NSProcessInfo processInfo] endActivity:n00_interaction_token];
+    [n00_interaction_token release];
+    n00_interaction_token = nil;
+    [pool release];
+    trace_n00_lease_transition(get_clock(), 1, reason,
+        n00_interaction_generation, n00_interaction_deadline,
+        NSActivityUserInitiatedAllowingIdleSystemSleep);
+    n00_interaction_deadline = 0;
+    dispatch_source_set_timer(n00_interaction_timer, DISPATCH_TIME_FOREVER,
+                              DISPATCH_TIME_FOREVER, 0);
+}
+
+static void n00_interaction_arm(void)
+{
+    int64_t remaining = MAX(1, n00_interaction_deadline - get_clock());
+    dispatch_source_set_timer(n00_interaction_timer,
+        dispatch_time(DISPATCH_TIME_NOW, remaining), DISPATCH_TIME_FOREVER,
+        10 * SCALE_MS);
+}
+
+static void n00_interaction_input(unsigned kind)
+{
+    assert([NSThread isMainThread]);
+    if (n00_interaction_closed) {
+        return;
+    }
+    NSWindow *window = [cocoaView window];
+    bool accepted = n00_interaction_enabled && ![NSApp isHidden] &&
+                    [window isVisible] && ![window isMiniaturized];
+    int64_t now = get_clock();
+    trace_n00_lease_input(now, kind, accepted, n00_interaction_token != nil);
+    if (!accepted) {
+        return;
+    }
+    n00_interaction_deadline = now + N00_INTERACTION_NS;
+    if (!n00_interaction_token) {
+        NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+        n00_interaction_token = [[[NSProcessInfo processInfo]
+            beginActivityWithOptions:NSActivityUserInitiatedAllowingIdleSystemSleep
+            reason:@"Harmattan QEMU input response (8 second idle timeout)"] retain];
+        [pool release];
+        if (!n00_interaction_token) {
+            error_report("N00 input activity request returned no token");
+            exit(1);
+        }
+        n00_interaction_generation++;
+        trace_n00_lease_transition(get_clock(), 0, 0,
+            n00_interaction_generation, n00_interaction_deadline,
+            NSActivityUserInitiatedAllowingIdleSystemSleep);
+    } else {
+        trace_n00_lease_renew(now, n00_interaction_generation,
+                             n00_interaction_deadline);
+    }
+    n00_interaction_arm();
+}
+
+static void n00_interaction_notify(Notifier *notifier, void *data)
+{
+    const InputEvent *event = data;
+    unsigned kind = event->type;
+    /* Never block the BQL on the Cocoa queue, or retain the borrowed event. */
+    dispatch_async(dispatch_get_main_queue(), ^{
+        n00_interaction_input(kind);
+    });
+}
+
+static Notifier n00_interaction_notifier = {
+    .notify = n00_interaction_notify,
+};
+
+static void n00_interaction_init(void)
+{
+    const char *value = getenv("N00_COCOA_INTERACTION");
+    assert([NSThread isMainThread]);
+    if (value && strcmp(value, "0") && strcmp(value, "1")) {
+        error_report("N00_COCOA_INTERACTION must be 0 or 1");
+        exit(1);
+    }
+    n00_interaction_enabled = value && !strcmp(value, "1");
+    if (n00_interaction_enabled && n00_activity_enabled) {
+        error_report("Whole-run and input-scoped activities are mutually exclusive");
+        exit(1);
+    }
+    trace_n00_lease_config(n00_interaction_enabled, 8000);
+    n00_interaction_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER,
+        0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(n00_interaction_timer, DISPATCH_TIME_FOREVER,
+                              DISPATCH_TIME_FOREVER, 0);
+    dispatch_source_set_event_handler(n00_interaction_timer, ^{
+        if (!n00_interaction_closed && n00_interaction_token) {
+            if (get_clock() < n00_interaction_deadline) {
+                n00_interaction_arm();
+            } else {
+                n00_interaction_release(1);
+            }
+        }
+    });
+    dispatch_resume(n00_interaction_timer);
+    NSNotificationName names[] = {NSApplicationDidHideNotification,
+        NSWindowDidMiniaturizeNotification, NSWindowWillCloseNotification};
+    for (unsigned i = 0; i < G_N_ELEMENTS(names); i++) {
+        id object = i ? (id)[cocoaView window] : (id)NSApp;
+        n00_interaction_observers[i] = [[[NSNotificationCenter defaultCenter]
+            addObserverForName:names[i] object:object queue:nil
+            usingBlock:^(NSNotification *note) {
+                n00_interaction_release(2);
+            }] retain];
+    }
+    qemu_input_add_event_notifier(&n00_interaction_notifier);
+}
+
+static void n00_interaction_shutdown(void)
+{
+    assert([NSThread isMainThread]);
+    n00_interaction_closed = true;
+    n00_interaction_release(3);
+    for (unsigned i = 0; i < G_N_ELEMENTS(n00_interaction_observers); i++) {
+        [[NSNotificationCenter defaultCenter]
+            removeObserver:n00_interaction_observers[i]];
+        [n00_interaction_observers[i] release];
+        n00_interaction_observers[i] = nil;
+    }
+    dispatch_source_cancel(n00_interaction_timer);
+    dispatch_release(n00_interaction_timer);
+    n00_interaction_timer = NULL;
+}
