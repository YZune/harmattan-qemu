      * SYSCLK and /1 reference: M=432,N=25 gives 432 MHz, CLKOUTX2=864 MHz.
      * /9 supplies 96 MHz; DSS/TV divisors remain guest-programmable.
      * This is a bootloader preset, not the silicon reset value. */
-    CM_RESET(0x0d00, 0x00170015);
+    CM_RESET(0x0d00, 0x00170017);
     CM_RESET(0x0d04, 0x00000011);
     CM_RESET(0x0d20, 0x00003f3c);
     CM_RESET(0x0d24, 0x0000000a);
-    CM_RESET(0x0d40, 0x08000040);
+    /* Direct boot also needs a locked CORE DPLL3 before the SRAM idle
