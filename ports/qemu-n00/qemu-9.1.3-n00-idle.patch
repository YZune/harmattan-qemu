+     * gives 166 MHz CORE/L3/SDRC with the /1 CM_CLKSEL_CORE preset.
+     * 166 MHz is in Nokia's SDRC timing table. This is a bootloader
+     * preset, not a reset value, and does not implement power domains. */
+    CM_RESET(0x0d40, 0x08a61940);
     CM_RESET(0x0d44, 0x0001b019);
     CM_RESET(0x0d48, 0x00000009);
     CM_RESET(0x0d50, 0x00000001);
@@ -249,6 +318,7 @@ static void n00_prm_domain_reset(N00RegisterBank *prm, hwaddr domain,
 
 static void n00_prm_reset(N00RegisterBank *prm)
 {
+    prm->power_manager = true;
     /* Reset values copied from Nokia's recovered OMAP3 PRM model. */
     n00_prm_domain_reset(prm, 0x0000, 0x7, 0x1, 0, 0, 0, 0xb3,
                          0x00ff0f07, 0x00000ff7);
@@ -288,6 +358,10 @@ static void n00_prm_reset(N00RegisterBank *prm)
     prm->words[0x129c >> 2] = 0xa;
     prm->words[0x12c4 >> 2] = 0x1;
     prm->words[0x12e4 >> 2] = 0x1;
