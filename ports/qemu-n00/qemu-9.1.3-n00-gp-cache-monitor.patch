+/* Explicit cache-only GP experiment. Unsupported SMC calls stop at ROM + 0x80. */
+static void n00_gp_cache_monitor_init(void)
+{
+    const char *mode = g_getenv("HARMATTAN_N00_GP_CACHE_MONITOR");
+    MemoryRegion *rom;
+
+    if (!mode || !strcmp(mode, "off")) {
+        return;
+    }
+    if (strcmp(mode, "on")) {
+        error_report("HARMATTAN_N00_GP_CACHE_MONITOR must be on or off");
+        exit(EXIT_FAILURE);
+    }
+    rom = g_new0(MemoryRegion, 1);
+    memory_region_init_rom(rom, NULL, "n00.gp-cache-monitor", 0x1000,
+                           &error_fatal);
+    memory_region_add_subregion(get_system_memory(), 0, rom);
+    rom_add_blob_fixed("n00.gp-cache-monitor", n00_gp_cache_monitor,
+                       sizeof(n00_gp_cache_monitor), 0);
+}
+
