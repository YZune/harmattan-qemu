+#define N00_SDRAM_BASE 0x80000000
+#define N00_SDRAM_SIZE (512 * MiB)
+#define N00_SRAM_BASE  0x40200000
+#define N00_SRAM_SIZE  0x00010000
+#define N00_INTC_BASE  0x48200000
+#define N00_UART3_BASE 0x49020000
+#define N00_UART3_IRQ  74
+#define N00_CM_BASE    0x48004000
+#define N00_PRM_BASE   0x48306000
+#define N00_USB_OTG_BASE 0x480ab000
+#define N00_MMC1_BASE   0x4809c000
+#define N00_MMC2_BASE   0x480b4000
+#define N00_MMC3_BASE   0x480ad000
+#define N00_PRCM_SIZE  0x00002000
+#define N00_RX71_MACHINE_ID 6666
+
+void n00_sdrc_init(MemoryRegion *sysmem, hwaddr base);
+
+typedef struct N00RegisterBank {
+    MemoryRegion iomem;
+    uint32_t words[N00_PRCM_SIZE / sizeof(uint32_t)];
+    bool clock_manager;
+} N00RegisterBank;
+
+static void n00_cm_pll_status(N00RegisterBank *cm, unsigned control,
+                               unsigned mode_shift, unsigned select,
+                               unsigned mult_shift, unsigned status,
+                               unsigned bit, unsigned bypass_modes)
+{
+    unsigned mode = (cm->words[control >> 2] >> mode_shift) & 7;
+    unsigned mult = (cm->words[select >> 2] >> mult_shift) & 0x7ff;
+    uint32_t *word = &cm->words[status >> 2];
+
+    if ((bypass_modes & (1 << mode)) || (mode == 7 && mult < 2)) {
+        *word &= ~(1 << bit);
+    } else if (mode == 7) {
+        *word |= 1 << bit;
+    }
+}
+
+static void n00_cm_update(N00RegisterBank *cm)
+{
+    /* Nokia OMAP3 CM lock/bypass transitions, without rate propagation yet. */
+    n00_cm_pll_status(cm, 0x004, 0, 0x040, 8, 0x024, 0,
+                       (1 << 1) | (1 << 5));
+    n00_cm_pll_status(cm, 0x904, 0, 0x940, 8, 0x924, 0, 1 << 5);
+    n00_cm_pll_status(cm, 0xd00, 0, 0xd40, 16, 0xd20, 0,
+                       (1 << 5) | (1 << 6));
+    n00_cm_pll_status(cm, 0xd00, 16, 0xd44, 8, 0xd20, 1, 1 << 1);
+    n00_cm_pll_status(cm, 0xd04, 0, 0xd4c, 8, 0xd24, 0, 1 << 1);
+}
+
+static uint64_t n00_register_bank_read(void *opaque, hwaddr offset,
+                                       unsigned size)
+{
+    N00RegisterBank *bank = opaque;
+    uint32_t value = bank->words[offset >> 2];
+    unsigned shift = (offset & 3) * 8;
+    uint64_t mask = MAKE_64BIT_MASK(0, size * 8);
+
+    return (value >> shift) & mask;
+}
+
+static void n00_register_bank_write(void *opaque, hwaddr offset,
+                                    uint64_t value, unsigned size)
+{
+    N00RegisterBank *bank = opaque;
+    unsigned shift = (offset & 3) * 8;
+    uint32_t mask = MAKE_64BIT_MASK(shift, size * 8);
+    uint32_t *word = &bank->words[offset >> 2];
+
+    *word = (*word & ~mask) | ((value << shift) & mask);
+    if (bank->clock_manager) {
+        n00_cm_update(bank);
+    }
+}
+
+static const MemoryRegionOps n00_register_bank_ops = {
+    .read = n00_register_bank_read,
+    .write = n00_register_bank_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static void n00_register_bank_map(N00RegisterBank *bank, const char *name,
+                                  hwaddr base, uint64_t size)
+{
+    memory_region_init_io(&bank->iomem, NULL, &n00_register_bank_ops, bank,
+                          name, size);
+    memory_region_add_subregion_overlap(get_system_memory(), base,
+                                        &bank->iomem, 10);
+}
+
+static void n00_cm_reset(N00RegisterBank *cm)
+{
+#define CM_RESET(offset, value) cm->words[(offset) >> 2] = (value)
+    /*
+     * Register defaults come from Nokia's recovered OMAP3 CM model.  For
+     * module IDLEST registers use active values during this bootstrap.
+     * PLL lock/bypass status is updated dynamically on writes.
+     */
+    CM_RESET(0x0004, 0x00000011);
+    CM_RESET(0x0020, 0x00000000);
+    CM_RESET(0x0024, 0x00000000);
+    CM_RESET(0x0040, 0x00080000);
+    CM_RESET(0x0044, 0x00000001);
+    CM_RESET(0x0800, 0x00000010);
+    CM_RESET(0x0810, 0x00000001);
+    CM_RESET(0x0904, 0x00000015);
+    CM_RESET(0x0920, 0x00000000);
+    CM_RESET(0x0924, 0x00000000);
+    CM_RESET(0x0940, 0x00080000);
+    CM_RESET(0x0944, 0x00000001);
+    CM_RESET(0x0a10, 0x00000042);
+    CM_RESET(0x0a20, 0x00000000);
+    CM_RESET(0x0a28, 0x00000000);
+    CM_RESET(0x0a40, 0x00001105);
+    CM_RESET(0x0b20, 0x00000000);
+    CM_RESET(0x0c40, 0x00000012);
+    CM_RESET(0x0d00, 0x00110015);
+    CM_RESET(0x0d04, 0x00000011);
+    CM_RESET(0x0d20, 0x00003f3c);
+    CM_RESET(0x0d24, 0x0000000a);
+    CM_RESET(0x0d40, 0x08000040);
+    CM_RESET(0x0d44, 0x00000000);
+    CM_RESET(0x0d48, 0x00000001);
+    CM_RESET(0x0d50, 0x00000001);
+    CM_RESET(0x0d70, 0x00000003);
+    CM_RESET(0x0e40, 0x00001010);
+    CM_RESET(0x0f20, 0x00000000);
+    CM_RESET(0x0f40, 0x00000010);
+    CM_RESET(0x1140, 0x10100a50);
+    CM_RESET(0x1148, 0x00000002);
+    CM_RESET(0x1320, 0x00000000);
+    CM_RESET(0x1420, 0x00000000);
+#undef CM_RESET
+}
+
+static void n00_prm_domain_reset(N00RegisterBank *prm, hwaddr domain,
+                                 uint32_t rstctrl, uint32_t rstst,
+                                 uint32_t wken, uint32_t mpugrpsel,
+                                 uint32_t ivagrpsel, uint32_t wkdep,
+                                 uint32_t pwstctrl, uint32_t pwstst)
+{
+    prm->words[(domain + 0x50) >> 2] = rstctrl;
+    prm->words[(domain + 0x58) >> 2] = rstst;
+    prm->words[(domain + 0xa0) >> 2] = wken;
+    prm->words[(domain + 0xa4) >> 2] = mpugrpsel;
+    prm->words[(domain + 0xa8) >> 2] = ivagrpsel;
+    prm->words[(domain + 0xc8) >> 2] = wkdep;
+    prm->words[(domain + 0xe0) >> 2] = pwstctrl;
+    prm->words[(domain + 0xe4) >> 2] = pwstst;
+}
+
+static void n00_prm_reset(N00RegisterBank *prm)
+{
+    /* Reset values copied from Nokia's recovered OMAP3 PRM model. */
+    n00_prm_domain_reset(prm, 0x0000, 0x7, 0x1, 0, 0, 0, 0xb3,
+                         0x00ff0f07, 0x00000ff7);
+    n00_prm_domain_reset(prm, 0x0900, 0, 0x1, 0, 0, 0, 0xa5,
+                         0x00030107, 0x000000c7);
+    n00_prm_domain_reset(prm, 0x0a00, 0, 0x1, 0xc33ffe18, 0xc33ffe18,
+                         0xc33ffe18, 0, 0x000f0307, 0x000000f7);
+    n00_prm_domain_reset(prm, 0x0b00, 0, 0x1, 0, 0, 0, 0x16,
+                         0x00030107, 0x00000003);
+    n00_prm_domain_reset(prm, 0x0c00, 0, 0, 0x3cb, 0x3cb, 0, 0,
+                         0, 0x3);
+    n00_prm_domain_reset(prm, 0x0e00, 0, 0x1, 0x1, 0, 0, 0x16,
+                         0x00030107, 0x3);
+    n00_prm_domain_reset(prm, 0x0f00, 0, 0x1, 0, 0, 0, 0x16,
+                         0x00030107, 0x3);
+    n00_prm_domain_reset(prm, 0x1000, 0, 0x1, 0x3efff, 0x3efff, 0x3efff,
+                         0x17, 0x00030107, 0x7);
+    n00_prm_domain_reset(prm, 0x1100, 0, 0x1, 0, 0, 0, 0,
+                         0, 0x13);
+    n00_prm_domain_reset(prm, 0x1300, 0, 0x1, 0, 0, 0, 0x2,
+                         0x7, 0x3);
+    n00_prm_domain_reset(prm, 0x1400, 0, 0x1, 0x1, 0x1, 0x1, 0x17,
+                         0x00030107, 0x3);
+    prm->words[0x0804 >> 2] = 0x10;
+    prm->words[0x0814 >> 2] = 0x1;
+    prm->words[0x0af4 >> 2] = 0x4;
+    prm->words[0x0af8 >> 2] = 0x4;
+    prm->words[0x0d40 >> 2] = 0x3;
+    prm->words[0x0d70 >> 2] = 0x80;
+    prm->words[0x0de4 >> 2] = 0x3;
+    prm->words[0x0de8 >> 2] = 0x3;
+    prm->words[0x1238 >> 2] = 0x18;
+    prm->words[0x1254 >> 2] = 0x1006;
+    prm->words[0x1258 >> 2] = 0x1;
+    prm->words[0x1264 >> 2] = 0x50;
+    prm->words[0x1270 >> 2] = 0x43;
+    prm->words[0x129c >> 2] = 0xa;
+    prm->words[0x12c4 >> 2] = 0x1;
+    prm->words[0x12e4 >> 2] = 0x1;
+}
+
+static void n00_mmc2_init(DeviceState *intc, qemu_irq *drq)
+{
+    DeviceState *controller = qdev_new("n00-omap3-mmc");
+    DeviceState *card;
+    SysBusDevice *sbd;
+    DriveInfo *dinfo;
+    BlockBackend *blk;
+
+    sbd = SYS_BUS_DEVICE(controller);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, N00_MMC2_BASE);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(intc, 86));
+    sysbus_connect_irq(sbd, 1, drq[47]); /* MMC2 TX */
+    sysbus_connect_irq(sbd, 2, drq[48]); /* MMC2 RX */
+
+    dinfo = drive_get(IF_SD, 0, 0);
+    blk = dinfo ? blk_by_legacy_dinfo(dinfo) : NULL;
+    /* RX-71 MMC2 is the soldered, non-removable MMC/eMMC slot. */
+    card = qdev_new(TYPE_EMMC);
+    qdev_prop_set_bit(card, "dual-voltage", true);
+    qdev_prop_set_drive_err(card, "drive", blk, &error_fatal);
+    qdev_realize_and_unref(card, qdev_get_child_bus(controller, "sd-bus"),
+                           &error_fatal);
+}
