diff --git a/ui/cocoa.m b/ui/cocoa.m
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -108,6 +108,49 @@
 static NSTextField *pauseLabel;
 
 static bool allow_events;
+
+/* Only the independent diagnostic build uses this opt-in activity assertion.
+ * It neither prevents display/system idle sleep nor changes saved defaults. */
+static bool n00_activity_enabled;
+static id<NSObject> n00_activity_token;
+static NSActivityOptions n00_activity_options;
+
+static void n00_activity_begin(void)
+{
+    const char *value = getenv("N00_COCOA_ACTIVITY");
+    if (value && strcmp(value, "0") && strcmp(value, "1")) {
+        error_report("N00_COCOA_ACTIVITY must be 0 or 1");
+        exit(1);
+    }
+    n00_activity_enabled = value && !strcmp(value, "1");
+    if (n00_activity_enabled) {
+        NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+        n00_activity_options = NSActivityUserInitiatedAllowingIdleSystemSleep;
+        n00_activity_token = [[[NSProcessInfo processInfo]
+            beginActivityWithOptions:n00_activity_options
+            reason:@"Bounded Harmattan QEMU scheduling diagnostic"] retain];
+        [pool release];
+        if (!n00_activity_token) {
+            error_report("N00 Cocoa activity request returned no token");
+            exit(1);
+        }
+    }
+    trace_n00_activity_lifecycle(get_clock(), 0, n00_activity_enabled,
+                                  n00_activity_options);
+}
+
+static void n00_activity_end(void)
+{
+    if (n00_activity_token) {
+        NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+        [[NSProcessInfo processInfo] endActivity:n00_activity_token];
+        [n00_activity_token release];
+        n00_activity_token = nil;
+        [pool release];
+    }
+    trace_n00_activity_lifecycle(get_clock(), 1, n00_activity_enabled,
+                                  n00_activity_options);
+}
 
 static NSInteger cbchangecount = -1;
 static QemuClipboardInfo *cbinfo;
@@ -2037,6 +2080,7 @@
     status = qemu_default_main();
     bql_unlock();
     COCOA_DEBUG("Second thread: qemu_default_main() returned, exiting\n");
+    n00_activity_end();
     [cbowner release];
     exit(status);
 }
@@ -2047,6 +2091,7 @@
 
     COCOA_DEBUG("Entered %s()\n", __func__);
 
+    n00_activity_begin();
     bql_unlock();
     qemu_thread_create(&thread, "qemu_main", call_qemu_main,
                        NULL, QEMU_THREAD_DETACHED);
@@ -2072,6 +2117,12 @@
     dispatch_async(dispatch_get_main_queue(), ^{
         if (profile) {
             trace_n00_profile_cocoa_queue(started, get_clock() - started, w, h);
+        }
+        if (trace_event_get_state_backends(TRACE_N00_ACTIVITY_OBSERVE)) {
